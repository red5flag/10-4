# SIM7600G-H 4G HAT — USB serial port permissions
# Vendor 1e0e (Quectel), Product 9001 (SIM7600)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9001", MODE="0660", GROUP="dialout"

# SIM7600 alternate modes (EC20 / SIM7600 in different USB configs)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0125", MODE="0660", GROUP="dialout"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9011", MODE="0660", GROUP="dialout"

# Trigger usb-modeswitch when SIM7600 enumerates as mass storage (CD-ROM mode)
# Vendor 1e0e, Product 9001 in mass-storage mode is 1e0e:9001 or 1e0e:9011
SUBSYSTEM=="usb", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9001", RUN+="/usr/sbin/usb_modeswitch -v 1e0e -p 9001 -M '5553424312345678000000000000061e000000000000000000000000000000'"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1e0e", ATTRS{idProduct}=="9011", RUN+="/usr/sbin/usb_modeswitch -v 1e0e -p 9011 -M '5553424312345678000000000000061e000000000000000000000000000000'"

# GPS serial devices (common GPS HATs: U-blox, Adafruit Ultimate GPS)
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a7", MODE="0660", GROUP="dialout"
# Generic CP210x USB-to-UART (common on GPS/radio HATs)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0660", GROUP="dialout"

# Audio devices — ensure pikiosk user can access ALSA
SUBSYSTEM=="sound", GROUP="audio", MODE="0660"

# HaLo HAT / LoRa radio serial devices (typical SX127x/SX126x USB bridge)
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea71", MODE="0660", GROUP="dialout"
